meta {
  name: Invalidate All Sessions
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/v1/auth/invalidate-all
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  user_id: {{userId}}
}

docs {
  Revoga todas as sessões de um usuário.

  Exclusiva de administradores (0.40). Sem token: 401. Com token de usuário comum: 403 — inclusive
  quando o `user_id` da query é o dele mesmo; para encerrar a própria sessão existe POST /v1/auth/logout.

  Em desenvolvimento o usuário do seed (`task sud` / `task sdfull`) já é administrador.
}
