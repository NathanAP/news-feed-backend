meta {
  name: List Feeds
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/feeds
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  ~name:
  ~page: 1
  ~page_size: 20
}

docs {
  Lista apenas os feeds do usuário do token.

  Filtro opcional:
  - name: filtra por substring no nome (case-insensitive)

  Paginação: page (mín/padrão 1) e page_size (mín 1, máx 100, padrão 20). Resposta paginada:
  { docs: [...], pagination: {...} }. Ver PROJECT.md.

  Exemplos:
  - /v1/feeds
  - /v1/feeds?name=metal
  - /v1/feeds?page=2&page_size=10
}
