meta {
  name: Update Article
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/articles/:id
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:path {
  id: {{articleId}}
}

body:json {
  {
    "title": "Metallica anuncia nova turnê mundial (atualizado)",
    "content": "# Metallica anuncia nova turnê\n\nConteúdo atualizado...",
    "url_original": "https://www.wikimetal.com.br/noticia/metallica-turne",
    "keywords": ["metallica", "rock", "metal", "turnê", "show"],
    "language_original": "pt"
  }
}

docs {
  Todos os campos são obrigatórios (mesmas regras do create), incluindo language_original
  ("pt" | "en" | "es" | "fr" | "de" | "it"). O source_id continua imutável (não faz parte do body).
  Retorna 409 em conflito de url_original e 404 se a notícia não existir.
}
