meta {
  name: Update My Preferences
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/v1/users/me/preferences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "language_to_translate": "pt",
    "ai_personality": "mixed"
  }
}

docs {
  Valores aceitos:
  - language_to_translate: "pt" | "en" | "es" | "fr" | "de" | "it" | null
    (null = sem tradução; o client esconde a opção. É apenas dica de client, não afeta a API.)
  - ai_personality: "fun" | "informative" | "mixed"

  Retorna: { access_token, expires_in, preferences }
  O access_token retornado já contém as preferências atualizadas.
}
