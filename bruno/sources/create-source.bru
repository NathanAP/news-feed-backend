meta {
  name: Create Source
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/sources/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Wikimetal",
    "url": "https://www.wikimetal.com.br/",
    "url_rss": "https://www.wikimetal.com.br/feed/"
  }
}

docs {
  Campos obrigatórios:
  - name: nome de exibição da fonte (máx. 120 caracteres)
  - url: URL base da fonte (deve ser http ou https)
  - url_rss: URL do feed RSS/Atom (deve ser http ou https)

  Retorna 409 se a URL já estiver cadastrada.
  Use GET /v1/sources/rss-discovery para tentar descobrir o url_rss automaticamente.
}
