meta {
  name: Update Source
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/sources/:id
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:path {
  id: {{sourceId}}
}

body:json {
  {
    "url": "https://g1.globo.com",
    "url_rss": "https://g1.globo.com/rss/g1/index.xml"
  }
}

docs {
  Ambos os campos são obrigatórios. Retorna 409 em caso de conflito de URL.
}
