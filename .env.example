PROJECT_NAME=news-feed-backend
PROJECT_VERSION=0.28.1.0

API_VERSION=v1
API_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173

ENVIRONMENT=development
VERBOSE_MODE=true

GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:3000/v1/auth/google/callback

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Native (task ls): keep localhost. In Docker, the container can't reach the host's Ollama via
# localhost — prefer KEYWORDS_MODE=groq|gemini, or set this to http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434

TREATMENT_PROVIDER=google
TREATMENT_MODEL=gemini-2.5-flash
TREATMENT_VERBOSE_MODE=true

KEYWORDS_MODE=groq
KEYWORDS_VERBOSE_MODE=true

JUDGEMENT_MODE=groq
JUDGEMENT_VERBOSE_MODE=true
JUDGEMENT_THRESHOLD=70

TRANSLATION_PROVIDER=google
TRANSLATION_MODEL=gemini-2.5-flash
TRANSLATION_VERBOSE_MODE=true

RSS_FEED_CRON_ACTIVE=true
RSS_FEED_CRON_SCHEDULE=@every 15m
RSS_FEED_CRON_VERBOSE_MODE=true
# How many sources / articles the discovery pipeline processes in parallel. Keep at 1 in dev
# (deterministic, sequential); raise in staging/production, bounded by the AI provider rate limit.
DISCOVERY_CONCURRENCY=1

JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
