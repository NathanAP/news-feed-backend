PROJECT_NAME=news-feed-backend
PROJECT_VERSION=0.43.0.0

API_VERSION=v1
API_PORT=3000

ENVIRONMENT=development
VERBOSE_MODE=true

DATABASE_URL=postgres://news_feed:news_feed@localhost:5432/news_feed?sslmode=disable

POSTGRES_USER=news_feed
POSTGRES_PASSWORD=news_feed
POSTGRES_DB=news_feed

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:3000/v1/auth/google/callback

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_HEADERS=Authorization,Content-Type

OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/callback

CLIENT_URL=http://localhost:5173

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OLLAMA_BASE_URL=http://localhost:11434

# Logs dos passos deterministicos de tratamento do corpo da noticia. Apesar do nome, cobre os DOIS
# passos que rodam antes da sanitizacao: o tratamento de URLs (links internos -> CLIENT_URL) e o de
# embeds (Instagram -> link, parent do iframe do Twitch). O nome ficou da 0.35, quando so existia o
# primeiro; os dois andam juntos e sempre foram ligados/desligados pelo mesmo flag.
URLS_TREATMENT_VERBOSE_MODE=true

KEYWORDS_MODE=groq
KEYWORDS_VERBOSE_MODE=true

JUDGEMENT_MODE=groq
JUDGEMENT_VERBOSE_MODE=true
JUDGEMENT_THRESHOLD=65
JUDGEMENT_AUTOASSOCIATE_RATIO=0.30
JUDGEMENT_MIN_MATCHES=2

TRANSLATION_PROVIDER=google
TRANSLATION_MODEL=gemini-2.5-flash
TRANSLATION_VERBOSE_MODE=true

RSS_FEED_CRON_ACTIVE=true
RSS_FEED_CRON_SCHEDULE=@every 15m
RSS_FEED_CRON_VERBOSE_MODE=true

DISCOVERY_CONCURRENCY=1

DISCOVERY_MAX_ARTICLES=-1

KEYWORD_SUGGESTIONS_WINDOW_DAYS=30

DAYS_UNTIL_USER_IS_INACTIVE=15

JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
