PROJECT_NAME=news-feed-backend
PROJECT_VERSION=0.21.2.0

API_VERSION=v1
API_PORT=3000

ENVIRONMENT=development

VERBOSE_MODE=true

GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:3000/v1/auth/google/callback

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

OLLAMA_BASE_URL=http://localhost:11434

TREATMENT_PROVIDER=google
TREATMENT_MODEL=gemini-2.5-flash
TREATMENT_VERBOSE_MODE=true

KEYWORDS_MODE=local
KEYWORDS_VERBOSE_MODE=true

RSS_FEED_CRON_ACTIVE=true
RSS_FEED_CRON_SCHEDULE=@every 15m
RSS_FEED_CRON_VERBOSE_MODE=true

JUDGE_SCORE_THRESHOLD=70

JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
