# Template for the production environment. Copy to `.env.production` (gitignored) and fill in.
#
# SECRETS MUST NOT LIVE IN A PLAIN FILE IN PRODUCTION. The values marked "secret" should be injected
# from a secret store (AWS SSM Parameter Store / Secrets Manager) at deploy time. This template only
# documents the NAMES the app expects; everything not marked "secret" is plain config.

# --- Which image to run (set by CI/deploy, not hand-edited) ---------------------------------------
# The immutable registry tag CI built and pushed — the SAME artifact that passed through staging,
# promoted, never rebuilt on the host.
API_IMAGE=CHANGE_ME

# --- App identity / runtime -----------------------------------------------------------------------
PROJECT_NAME=news-feed-backend
PROJECT_VERSION=0.48.1.0

API_VERSION=v1
API_PORT=3000

ENVIRONMENT=production
# Off in production: VERBOSE_MODE prints request data to the log, which is noise (and a data-exposure
# risk) on a real deployment.
VERBOSE_MODE=false

# --- Database -------------------------------------------------------------------------------------
# Default: a managed database (AWS RDS). Point DATABASE_URL at the RDS endpoint. docker-compose.prod.yaml
# has NO Postgres container, so this URL is the single source of truth.
#   sslmode=require, not disable: a managed DB is reached over the network, so TLS is not optional.
# If instead you enable the container Postgres in docker-compose.prod.yaml, set the host back to
# @postgres and fill POSTGRES_USER/PASSWORD/DB below.
DATABASE_URL=postgres://USER:PASSWORD@your-db.xxxxxx.rds.amazonaws.com:5432/news_feed?sslmode=require   # secret
# Only needed if you run the container Postgres instead of RDS (otherwise ignore these three):
POSTGRES_USER=news_feed
POSTGRES_PASSWORD=CHANGE_ME            # secret
POSTGRES_DB=news_feed

# --- Google OAuth ---------------------------------------------------------------------------------
GOOGLE_API_KEY=CHANGE_ME               # secret
GOOGLE_CLIENT_ID=CHANGE_ME             # secret
GOOGLE_CLIENT_SECRET=CHANGE_ME         # secret
GOOGLE_REDIRECT_URL=https://api.example.com/v1/auth/google/callback

# --- CORS / client --------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_HEADERS=Authorization,Content-Type
OAUTH_ALLOWED_REDIRECT_URIS=https://app.example.com/auth/callback
CLIENT_URL=https://app.example.com

# --- AI providers ---------------------------------------------------------------------------------
GROQ_API_KEY=CHANGE_ME                 # secret
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434

KEYWORDS_MODE=groq
KEYWORDS_VERBOSE_MODE=false
JUDGEMENT_MODE=groq
JUDGEMENT_VERBOSE_MODE=false
JUDGEMENT_THRESHOLD=65
JUDGEMENT_AUTOASSOCIATE_RATIO=0.30
JUDGEMENT_MIN_MATCHES=2

TRANSLATION_PROVIDER=google
TRANSLATION_MODEL=gemini-2.5-flash
TRANSLATION_VERBOSE_MODE=false

URLS_TREATMENT_VERBOSE_MODE=false

# --- Discovery / CRON -----------------------------------------------------------------------------
# Single instance only: this CRON runs in-process. Never scale the API to more than one replica with
# RSS_FEED_CRON_ACTIVE=true, or discovery runs multiple times (duplicate articles, duplicate AI calls).
RSS_FEED_CRON_ACTIVE=true
RSS_FEED_CRON_SCHEDULE=@every 15m
RSS_FEED_CRON_VERBOSE_MODE=false
DISCOVERY_CONCURRENCY=4
DISCOVERY_MAX_ARTICLES=-1
KEYWORD_SUGGESTIONS_WINDOW_DAYS=30
# Days without activity before a user's feeds stop receiving discovered news. -1 disables the filter.
DAYS_UNTIL_USER_IS_INACTIVE=15

# --- JWT ------------------------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME               # secret
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
