# Template for the staging environment. Copy to `.env.staging` (which is gitignored) and fill in.
#
# SECRETS DO NOT BELONG IN THE REAL FILE ON A SERVER YOU DON'T CONTROL. The values marked "secret"
# below should come from a secret store (AWS SSM Parameter Store / Secrets Manager) injected at deploy
# time, not be typed into a file that could leak. This template exists only to document the NAMES the
# app expects. Everything not marked "secret" is plain config and is safe to keep in the file.

# --- Which image to run (set by CI/deploy, not hand-edited) ---------------------------------------
# The registry tag CI built and pushed (e.g. <account>.dkr.ecr.<region>.amazonaws.com/news-feed:<sha>).
# The deploy step sets this; the compose file pulls it. Locally it defaults to news-feed-api:local.
API_IMAGE=news-feed-api:staging

# --- App identity / runtime -----------------------------------------------------------------------
PROJECT_NAME=news-feed-backend
PROJECT_VERSION=0.48.3.0

API_VERSION=v1
API_PORT=3000

ENVIRONMENT=staging
VERBOSE_MODE=true

# --- Database -------------------------------------------------------------------------------------
# Staging uses the container Postgres from docker-compose.staging.yaml. The compose file forces
# DATABASE_URL to reach it by service name, so the value here is only for reference/parity.
POSTGRES_USER=news_feed
POSTGRES_PASSWORD=CHANGE_ME            # secret
POSTGRES_DB=news_feed
DATABASE_URL=postgres://news_feed:CHANGE_ME@postgres:5432/news_feed?sslmode=disable   # secret (contains the password)

# --- Google OAuth ---------------------------------------------------------------------------------
GOOGLE_API_KEY=CHANGE_ME               # secret
GOOGLE_CLIENT_ID=CHANGE_ME             # secret
GOOGLE_CLIENT_SECRET=CHANGE_ME         # secret
GOOGLE_REDIRECT_URL=https://staging-api.example.com/v1/auth/google/callback

# --- CORS / client --------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://staging.example.com
CORS_ALLOWED_HEADERS=Authorization,Content-Type
OAUTH_ALLOWED_REDIRECT_URIS=https://staging.example.com/auth/callback
CLIENT_URL=https://staging.example.com

# --- AI providers ---------------------------------------------------------------------------------
GROQ_API_KEY=CHANGE_ME                 # secret
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434

KEYWORDS_MODE=groq
KEYWORDS_VERBOSE_MODE=false
JUDGEMENT_MODE=groq
JUDGEMENT_VERBOSE_MODE=false
JUDGEMENT_THRESHOLD=65
JUDGEMENT_AUTOASSOCIATE_RATIO=0.30
JUDGEMENT_MIN_MATCHES=2

TRANSLATION_PROVIDER=google
TRANSLATION_MODEL=gemini-2.5-flash
TRANSLATION_VERBOSE_MODE=false

URLS_TREATMENT_VERBOSE_MODE=false

# --- Discovery / CRON -----------------------------------------------------------------------------
# Single instance only: this CRON runs in-process. If you ever run more than one API replica, keep
# RSS_FEED_CRON_ACTIVE=true on exactly one and false on the others.
RSS_FEED_CRON_ACTIVE=true
RSS_FEED_CRON_SCHEDULE=@every 15m
RSS_FEED_CRON_VERBOSE_MODE=false
DISCOVERY_CONCURRENCY=4
DISCOVERY_MAX_ARTICLES=-1
KEYWORD_SUGGESTIONS_WINDOW_DAYS=30
# Days without activity before a user's feeds stop receiving discovered news. -1 disables the filter.
DAYS_UNTIL_USER_IS_INACTIVE=15

# --- JWT ------------------------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME               # secret
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
